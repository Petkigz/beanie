{
  "id": "demonstration_transfer",
  "description": "One-demonstration learning with transfer + analogy (T1/T6, rows 22/43): the rule from a single demo runs on a folder of new files, carries to kinds never demonstrated (.png/.txt beside .pdf/.jpg), and refuses the category the demo never covered (.mp3) instead of guessing.",
  "authority": "allow",
  "setup": {
    "dirs": [
      "downloads",
      "docs"
    ],
    "files": {
      "downloads/invoice.pdf": "x"
    }
  },
  "turns": [
    {
      "demo": {
        "title": "pdfs to docs",
        "goal_class": "organize files",
        "actions": [
          {
            "capability": "move_file",
            "args": {
              "src": "downloads/invoice.pdf",
              "dst": "docs"
            }
          }
        ]
      },
      "expect": "pdf"
    },
    {
      "files": {
        "downloads/statement.pdf": "y",
        "downloads/readme.md": "z",
        "downloads/theme.mp3": "m"
      },
      "perform": {
        "goal": "organize files",
        "base_dir": "downloads"
      },
      "expect": "inferred by analogy"
    },
    {
      "body": {
        "capability": "read_file",
        "args": {
          "path": "docs/statement.pdf"
        }
      },
      "expect": "statement.pdf"
    },
    {
      "body": {
        "capability": "read_file",
        "args": {
          "path": "docs/readme.md"
        }
      },
      "expect": "readme.md"
    },
    {
      "body": {
        "capability": "list_files",
        "args": {
          "dir": "downloads"
        }
      },
      "expect": "theme.mp3",
      "expect_absent": "statement.pdf"
    },
    {
      "query": {
        "kind": "self",
        "type": "question"
      },
      "expect": ".mp3"
    }
  ]
}
