{
  "id": "authority_gate",
  "description": "Four-state authority gate (§5): ungranted capabilities ask, a denied capability blocks a learned plan with an explicit refusal, and the same plan runs once the owner allows it.",
  "setup": {
    "dirs": [
      "downloads",
      "docs"
    ],
    "files": {
      "downloads/invoice.pdf": "x"
    }
  },
  "turns": [
    {
      "demo": {
        "title": "pdfs to docs",
        "goal_class": "organize files",
        "actions": [
          {
            "capability": "move_file",
            "args": {
              "src": "downloads/invoice.pdf",
              "dst": "docs"
            }
          }
        ]
      },
      "expect": "pdf"
    },
    {
      "user": "you may list_files",
      "expect": "i may do that now"
    },
    {
      "user": "you may mkdir",
      "expect": "i may do that now"
    },
    {
      "user": "you may snapshot",
      "expect": "i may do that now"
    },
    {
      "user": "never use move_file",
      "expect": "won't"
    },
    {
      "files": {
        "downloads/statement.pdf": "y"
      },
      "perform": {
        "goal": "organize files",
        "base_dir": "downloads"
      },
      "expect": "needs_permission"
    },
    {
      "body": {
        "capability": "list_files",
        "args": {
          "dir": "docs"
        }
      },
      "expect_absent": "statement.pdf"
    },
    {
      "user": "you may move_file",
      "expect": "i may do that now"
    },
    {
      "perform": {
        "goal": "organize files",
        "base_dir": "downloads"
      },
      "expect": "success"
    },
    {
      "body": {
        "capability": "read_file",
        "args": {
          "path": "docs/statement.pdf"
        }
      },
      "expect": "statement.pdf"
    }
  ]
}
